# Copia este archivo como ".env" para probar en tu ordenador.
# En Netlify estos dos valores se ponen en "Environment variables".
# Sin ellos, la app arranca en modo demostración con datos inventados.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Usa la clave publicable (sb_publishable_…). La clave «anon» antigua también funciona hasta que Supabase la retire.
